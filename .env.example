# Copy this file to .env and fill in. NEVER commit .env.
DISCORD_TOKEN=

COMMAND_PREFIX=!
DATA_DIR=./data/users

# What counts as AFK (not credited). Discord's server AFK channel is always AFK.
COUNT_DEAFENED=false   # deafened = can't hear anyone -> AFK
COUNT_MUTED=true       # muted listeners still count
COUNT_ALONE=true       # set false to stop people farming time alone in a channel

# Flush in-progress sessions to disk this often (seconds)
CHECKPOINT_SECONDS=300

PROGRESSION_CHANNEL=progression
ANNOUNCE_CHANNEL=generalpopulation
CROWD_THRESHOLD=7
CROWD_COOLDOWN_SECONDS=1800

# Redirect targets (channel IDs). Leave empty to disable.
NETTIAUTO_CHANNEL_ID=788403517231595571
CODE_CHANNEL_ID=755053446763380767

INVITE_URL=https://discord.gg/nlahoodz
