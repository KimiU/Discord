# Copy this file to .env and fill in. NEVER commit .env.
DISCORD_TOKEN=

COMMAND_PREFIX=!
DATA_DIR=./data/users

# What counts as AFK (not credited). Discord's server AFK channel is always AFK.
COUNT_DEAFENED=false   # deafened = can't hear anyone -> AFK
COUNT_MUTED=true       # muted listeners still count
COUNT_ALONE=true       # set false to stop people farming time alone in a channel

# Flush in-progress sessions to disk this often (seconds)
CHECKPOINT_SECONDS=300

PROGRESSION_CHANNEL=progression
ANNOUNCE_CHANNEL=generalpopulation
CROWD_THRESHOLD=7
CROWD_COOLDOWN_SECONDS=1800

# Redirect defaults. Restart after changing .env; chat changes take effect immediately.
REDIRECT_ENABLED=true
# suggest: recommend a channel; copy: keep original and copy; move: copy then delete.
REDIRECT_MODE=suggest
# One action per member/source channel in this many seconds (0 disables cooldown).
REDIRECT_COOLDOWN_SECONDS=300
# Persistent per-server settings made with !redirect. Keep this file backed up.
REDIRECT_RULES_FILE=./data/redirects.json
# Extra default rules (JSON). Chat commands are usually easier; see docs/redirects.md.
REDIRECT_RULES_JSON=[]

# Built-in redirect targets (channel IDs). Leave empty to disable that default rule.
NETTIAUTO_CHANNEL_ID=788403517231595571
CODE_CHANNEL_ID=755053446763380767

INVITE_URL=https://discord.gg/nlahoodz

# Full path to ffmpeg if the bot's account can't find it on PATH (e.g. on a Windows server)
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=
